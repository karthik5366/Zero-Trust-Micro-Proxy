# syntax=docker/dockerfile:1
FROM golang:1.21-alpine AS builder
WORKDIR /build
COPY data-plane-proxy/go.mod data-plane-proxy/go.sum ./
RUN go mod download
COPY data-plane-proxy/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /zeta-gateway .

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /zeta-gateway .
EXPOSE 8443
ENTRYPOINT ["/zeta-gateway"]
